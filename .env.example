# ── Azure AD App Registration (for SharePoint access via Microsoft Graph) ──
# Register an app at https://portal.azure.com > App registrations
# Grant it Sites.Read.All application permission and admin consent
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# ── Aftermath API (CHRobinson shipment data) ──
# Leave blank if not yet configured — projects will load without shipments
AFTERMATH_API_URL=

# ── Documents ──
# Path to the OneDrive-synced Commercial Proposals folder
PROPOSALS_PATH=C:\Users\green\OneDrive - Hydro-Wates\Commercial Proposals

# ── Server ──
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── Frontend (Vite) ──
# Set this to enable the frontend to call the real API instead of demo data
VITE_API_BASE_URL=http://localhost:3001/api
